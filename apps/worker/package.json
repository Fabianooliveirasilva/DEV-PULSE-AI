{
  "name": "@devpulse/worker",
  "version": "0.1.0",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --watch --env-file-if-exists=../../.env dist/main.js",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration"
  },
  "dependencies": {
    "@devpulse/ai": "workspace:*",
    "@devpulse/database": "workspace:*",
    "@devpulse/queue": "workspace:*",
    "@devpulse/shared": "workspace:*",
    "nodemailer": "10.4.0",
    "pino": "10.4.0",
    "prom-client": "15.1.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/nodemailer": "8.0.2",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
