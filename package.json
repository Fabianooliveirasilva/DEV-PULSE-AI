{
  "name": "devpulse-ai",
  "private": true,
  "version": "0.1.0",
  "description": "DevPulse AI — monitoring, incident management and AI-assisted error intelligence for web apps and APIs.",
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 run build",
    "build:packages": "pnpm --filter \"./packages/**\" run build",
    "dev:infra": "node scripts/dev-infra.mjs",
    "dev:api": "pnpm --filter @devpulse/api run dev",
    "dev:worker": "pnpm --filter @devpulse/worker run dev",
    "dev:web": "pnpm --filter @devpulse/web run dev",
    "db:migrate": "pnpm --filter @devpulse/database run migrate:dev",
    "db:deploy": "pnpm --filter @devpulse/database run migrate:deploy",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "test:integration": "pnpm -r --workspace-concurrency=1 run test:integration",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report tests/e2e/report"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/node": "22.19.0",
    "embedded-postgres": "18.6.0-beta.19",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@embedded-postgres/linux-x64",
      "@prisma/engines",
      "prisma",
      "argon2",
      "@swc/core",
      "esbuild",
      "msgpackr-extract",
      "sharp",
      "unrs-resolver"
    ]
  }
}
