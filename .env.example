# ─────────────────────────────────────────────────────────────────────────────
# DevPulse AI — environment template. Copy to `.env` and adjust.
# Never commit real secrets. Every variable is validated at startup (apps/api/src/config/env.ts).
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
LOG_LEVEL=info

# PostgreSQL (docker compose: postgresql://devpulse:devpulse@localhost:5432/devpulse;
# `pnpm dev:infra` without Docker: port 54329)
DATABASE_URL=postgresql://devpulse:devpulse@localhost:5432/devpulse

# Queue backend: `redis` (default, production) or `postgres` (BullMQ's PostgreSQL adapter,
# for machines without Redis). REDIS_URL also enables shared rate-limit counters.
QUEUE_BACKEND=redis
REDIS_URL=redis://localhost:6379

# API
PORT=4000
WEB_ORIGINS=http://localhost:3000
WEB_PUBLIC_URL=http://localhost:3000
SESSION_TTL_HOURS=168
# COOKIE_SECURE defaults to true in production (uses the __Host- cookie prefix).
# COOKIE_SECURE=false
# Number of trusted reverse proxies in front of the API (the Next.js /api proxy counts as one).
TRUST_PROXY=1

# E-mail: SMTP in real environments; MAIL_OUTBOX_DIR writes JSON files (dev/test only).
# SMTP_URL=smtp://user:pass@smtp.example.com:587
MAIL_FROM="DevPulse AI <no-reply@devpulse.local>"
MAIL_OUTBOX_DIR=.mail-outbox

# Dev/test only: private hosts monitors may reach (e.g. a local demo service). Must be empty in production.
SSRF_ALLOWLIST=

# Prometheus scrape token for /api/v1/metrics (min 16 chars). Unset disables the endpoint.
METRICS_TOKEN=change-me-to-a-long-random-token

# AI (optional). Without a key, AI analyses are recorded as "not configured" and never faked.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
AI_TIMEOUT_MS=60000

# Worker
WORKER_CONCURRENCY=10
WORKER_METRICS_PORT=9464

# Web (Next.js): where the server-side proxy forwards /api/* requests.
API_INTERNAL_URL=http://localhost:4000
